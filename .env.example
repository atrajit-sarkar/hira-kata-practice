# HiraKata configuration. Copy to .env (npm start/dev load it automatically) and adjust.

# HTTP listen address.
PORT=3000
HOST=127.0.0.1

# Database. With TURSO_DATABASE_URL set, HiraKata uses that remote libSQL (Turso) database: needed on
# hosts whose disk is wiped on restart (e.g. Render's free tier). Create one with
#   turso db create hirakata && turso db show --url hirakata && turso db tokens create hirakata
# The schema is created and migrated automatically on start. Keep the token secret.
# TURSO_DATABASE_URL=libsql://hirakata-<your-org>.turso.io
# TURSO_AUTH_TOKEN=

# Without TURSO_DATABASE_URL: a local SQLite file (created on first start). Relative paths are
# resolved from the project root.
DB_PATH=data/hirakata.db

# Word bank built by `npm run build:words` (gzipped JSON; a plain .json file also works).
WORDS_PATH=data/words.json.gz

# "production" hides error details and enables Secure cookies by default.
NODE_ENV=development

# Force the Secure cookie flag on/off (default: on only in production). Needs HTTPS when on.
# COOKIE_SECURE=true

# Set when running behind a reverse proxy so client IPs (rate limits) come from X-Forwarded-For.
# Use the number of proxy hops: 1 for a single reverse proxy such as Render. Also accepts an Express
# trust value (e.g. loopback). Avoid true: it trusts every hop, so clients could spoof their IP.
# TRUST_PROXY=1
